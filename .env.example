# Copy to .env.local and fill in. Never commit real values.
# .env.local is gitignored; this template carries names only.

# --- App -------------------------------------------------------------------
# Public base URL of this app. Used to build the widget embed snippet.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project settings -> API. Two projects: one for real use, one for tests.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Full database access, bypasses RLS. Server-side only — this must never be
# exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# --- Cohere (optional) -----------------------------------------------------
# Reranking sits behind a seam and stays off unless the eval run shows it helps.
# Leaving this unset keeps retrieval on plain vector similarity.
COHERE_API_KEY=

# --- Stripe (test mode) ----------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Price ids from Products in the Stripe dashboard (test mode).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=

# Copy to .env.local and fill in. Never commit real values.
# .env.local is gitignored; this template carries names only.

# --- App -------------------------------------------------------------------
# Public base URL of this app. Used to build the widget embed snippet.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project Settings -> API Keys. Prefer the "Publishable and secret API keys"
# tab over the legacy one: Supabase is deprecating anon/service_role.
#   publishable key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   secret key       -> SUPABASE_SERVICE_ROLE_KEY
# The variable names keep the conventional wording so they read the same as
# every Supabase example you will find.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row level security entirely. Server-side only — never expose this to
# the browser and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=

# --- Cohere (optional) -----------------------------------------------------
# Reranking sits behind a seam and stays off unless the eval run shows it helps.
# Leaving this unset keeps retrieval on plain vector similarity.
COHERE_API_KEY=

# --- Stripe (test mode) ----------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

# Price ids from Products in the Stripe dashboard (test mode).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
